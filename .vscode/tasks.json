{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DeploySphere: Backend",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "deploysphere-backend",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      },
      "inAgents": true
    },
    {
      "label": "DeploySphere: Frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "deploysphere-frontend",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:"
        }
      },
      "inAgents": true
    },
    {
      "label": "Run DeploySphere",
      "dependsOn": [
        "DeploySphere: Backend",
        "DeploySphere: Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "inAgents": true
    }
  ]
}
